# LiteLLM Gateway Security Keys
# Generate via: python3 -c "import secrets; print('sk-' + secrets.token_hex(32))"
LITELLM_MASTER_KEY=sk-placeholder_replace_with_secure_random_key_here
LITELLM_SALT_KEY=sk-placeholder_replace_with_secure_salt_key_here

# Remote GPU Worker Configuration (RunPod IP & SSH/API Endpoints)
RUNPOD_GPU_HOST=127.0.0.1
VLLM_INFERENCE_PORT=8000